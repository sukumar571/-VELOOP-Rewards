# ============================================================================
# VELOOP Rewards — frontend environment (Vite inlines only VITE_* at build time)
# ============================================================================
# Copy to `.env.local` for local overrides. Every value here is PUBLIC — a
# Vite build bakes these into the shipped JS bundle. NEVER put a secret, and
# above all NEVER the JWT signing secret, in a VITE_* variable. The signing
# secret lives only on the Express API (see backend/.env.example); the browser
# ever holds is an access-token credential.

# Base URL of the versioned REST API.
#   • Leave EMPTY in local dev to call /api/v1 same-origin and let the Vite
#     dev-server proxy forward to the Express API on :4000 (CORS-free).
#   • Set to a bare origin (e.g. https://api.veloop.example) to have the client
#     append the documented /api/v1 mount automatically.
#   • Or give the full prefix (e.g. https://api.veloop.example/api/v1).
VITE_API_BASE_URL=

# Explicitly-fictional development mocks (fake balances / participants / winners).
# Default: ON only when NO VITE_API_BASE_URL is configured AND this is not a
# production build. A production build can NEVER enable mocks — a real API
# failure is then shown honestly instead of papered over with fake data.
#   true / 1  → force mocks on (offline UI development)
#   false / 0 → force the real API even when no base URL is set
VITE_USE_MOCK_DATA=
