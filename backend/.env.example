# =============================================================================
# VELOOP Rewards Giveaway — backend environment template
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real database credentials, JWT signing secrets or user data.
# The values here are NON-SECRET placeholders for local development only.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated proxy hops to trust for correct client IPs / rate limiting.
# Leave 0 unless behind a known reverse proxy, then set the hop count or "true".
TRUST_PROXY=0

# --- MongoDB -------------------------------------------------------------------
# Local dev typically runs a Dockerized replica set (required for transactions).
# No credentials in this file example — inject the real, secret-bearing URI only
# in your .env / secret manager, never in the repo.
MONGODB_URI=mongodb://127.0.0.1:27017/veloop_giveaway
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20
# When false, the API still boots and serves /health (liveness) even if MongoDB
# is unreachable; /health/ready reports the outage. Keep false for local dev.
EXIT_ON_DB_FAILURE=false
# Seconds to wait for in-flight requests during shutdown.
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
# NOTE ON INDEXES: Mongoose builds indexes automatically outside production only.
# In production they are created by the migration runner:  npm run db:migrate
# (use `npm run db:migrate:dry` / `npm run db:migrate:check` to inspect first).

# --- Logging -------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Authentication ------------------------------------------------------------
# auth mode:
#   jwt       -> verify real VELOOP-issued access tokens (REQUIRES a secret/key)
#   dev-mock  -> LOCAL-ONLY verifier; FORBIDDEN when NODE_ENV=production
AUTH_MODE=dev-mock
# For AUTH_MODE=jwt with HMAC (HS256):
JWT_SECRET=
# For AUTH_MODE=jwt with RSA/EC public key (RS256/ES256) — paste the PEM:
JWT_PUBLIC_KEY=
# Comma-separated allowed algorithms. Match what VELOOP signs with.
JWT_ALGORITHMS=HS256
# Optional strict claim checks:
JWT_ISSUER=
JWT_AUDIENCE=
# Secret used ONLY by the dev-mock mode to mint/verify local demo tokens.
# It is not a production secret and is never used when AUTH_MODE=jwt.
DEV_JWT_SECRET=change-me-local-dev-only
DEV_JWT_TTL_SECONDS=28800

# --- Data model / privacy ----------------------------------------------------
# Salt for the pseudonymous device/session/IP hashes stored on participation and
# fraud records (raw device IDs, IPs and user-agents are never stored). Changing
# it breaks correlation across previously stored hashes, so treat it as a secret
# that must not rotate casually; the default is a local-dev placeholder only.
DEVICE_HASH_SALT=

# --- Security ------------------------------------------------------------------
# Comma-separated exact origins allowed by CORS (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Global request body size limit.
JSON_BODY_LIMIT=100kb
# Global rate limit (per window) and tighter limit for sensitive routes.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# --- VELOOP wallet integration -------------------------------------------------
# Balances live in the EXISTING VELOOP wallet — an external system this backend
# does not own. No wallet API contract/credential was supplied with this project,
# so the default is 'disabled': the adapter fails with 503 WALLET_NOT_CONFIGURED
# rather than inventing a balance or a successful debit.
#   disabled -> no provider calls are made (safe default)
#   http     -> real REST client; the values below must match YOUR wallet service
WALLET_MODE=disabled
WALLET_BASE_URL=
# Sent as `Authorization: Bearer <key>`. Secret — keep it in .env only.
WALLET_API_KEY=
# Path templates; {userId} and {currency} are substituted per call.
WALLET_BALANCE_PATH=
WALLET_DEBIT_PATH=
# Optional; defaults to WALLET_DEBIT_PATH when a refund is a signed debit.
WALLET_REVERSE_PATH=
# Name of the numeric balance field in the provider response.
WALLET_BALANCE_FIELD=balance
WALLET_TIMEOUT_MS=5000
# How long a cached WalletReference snapshot may be trusted for eligibility checks.
WALLET_SNAPSHOT_MAX_AGE_SECONDS=120

# --- Data retention policy ------------------------------------------------------
# OPTIONAL. Unset = fraud events are kept indefinitely (no TTL index is created).
# Set to a positive integer of days to let MongoDB expire FraudEvent documents
# once `expiresAt` passes. Applied by `npm run db:migrate`, never by app code.
# FRAUD_RETENTION_DAYS=30
